generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== ENUMS =====
enum VendorType {
  PHOTOGRAPHER
  SALON
  RENTAL
  CATERING
  DJ
  EVENT_COMPANY
  OTHER
}

enum BookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  HELD_IN_ESCROW
  RELEASED
  REFUNDED
  FAILED
}

enum PaymentMethod {
  ONLINE
  BANK_SLIP
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum DisputeStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  REJECTED
}

// ===== MODELS (TABLES) =====

model Admin {
  adminId          Int      @id @default(autoincrement()) @map("admin_id")
  email            String   @unique
  password         String
  role             String   @default("admin")
  registrationDate DateTime @default(now()) @map("registration_date")

  @@map("admin")
}

model Customer {
  customerId       Int      @id @default(autoincrement()) @map("customer_id")
  name             String
  email            String   @unique
  password         String
  contactNumber    String?  @map("contact_number")
  role             String   @default("customer")
  registrationDate DateTime @default(now()) @map("registration_date")

  bookings      Booking[]
  cart          Cart?
  orders        Order[]
  reviews       Review[]
  notifications Notification[]
  disputes      Dispute[]
  budgets       Budget[]
  refunds       RefundRequest[]

  @@map("customer")
}

model Vendor {
  vendorId           Int        @id @default(autoincrement()) @map("vendor_id")
  businessName       String     @map("business_name")
  email              String     @unique
  password           String
  description        String?
  contactNumber      String?    @map("contact_number")
  location           String?
  registrationNumber String?    @map("registration_number")
  establishedYear    Int?       @map("established_year")
  address            String?
  bannerImage        String?    @map("banner_image")
  logoImage          String?    @map("logo_image")
  socialFacebook     String?    @map("social_facebook")
  socialInstagram    String?    @map("social_instagram")
  socialTwitter      String?    @map("social_twitter")
  website            String?
  vendorType         VendorType @map("vendor_type")
  isApproved         Boolean    @default(true) @map("is_approved")
  registrationDate   DateTime   @default(now()) @map("registration_date")

  services      Service[]
  products      Product[]
  eventPackages EventPackage[]
  availability  Availability[]
  reviews       Review[]
  notifications Notification[]
  Dispute       Dispute[]

  @@map("vendor")
}

model ServiceCategory {
  categoryId   Int       @id @default(autoincrement()) @map("category_id")
  categoryName String    @map("category_name")
  services     Service[]
  products     Product[]

  @@map("service_category")
}

model Service {
  serviceId   Int      @id @default(autoincrement()) @map("service_id")
  serviceName String   @map("service_name")
  price       Decimal  @db.Decimal(10, 2)
  description String?
  imageUrl    String?  @map("image_url")
  isApproved  Boolean  @default(false) @map("is_approved")
  createdAt   DateTime @default(now()) @map("created_at")

  vendorId   Int              @map("vendor_id")
  categoryId Int?             @map("category_id")
  vendor     Vendor           @relation(fields: [vendorId], references: [vendorId], onDelete: Cascade)
  category   ServiceCategory? @relation(fields: [categoryId], references: [categoryId], onDelete: SetNull)
  bookings   Booking[]
  reviews    Review[]

  @@map("service")
}

model Product {
  productId   Int      @id @default(autoincrement()) @map("product_id")
  productName String   @map("product_name")
  price       Decimal  @db.Decimal(10, 2)
  quantity    Int      @default(0)
  imageUrl    String?  @map("image_url")
  description String?
  isApproved  Boolean  @default(false) @map("is_approved")
  createdAt   DateTime @default(now()) @map("created_at")

  vendorId   Int              @map("vendor_id")
  categoryId Int?             @map("category_id")
  vendor     Vendor           @relation(fields: [vendorId], references: [vendorId], onDelete: Cascade)
  category   ServiceCategory? @relation(fields: [categoryId], references: [categoryId], onDelete: SetNull)
  cartItems  CartItem[]
  orderItems OrderItem[]
  reviews    Review[]

  @@map("product")
}

model EventPackage {
  packageId   Int      @id @default(autoincrement()) @map("package_id")
  packageName String   @map("package_name")
  description String?
  price       Decimal  @db.Decimal(10, 2)
  category    String?
  duration    String?
  maxGuests   Int?     @map("max_guests")
  isApproved  Boolean  @default(false) @map("is_approved")
  createdAt   DateTime @default(now()) @map("created_at")

  vendorId Int              @map("vendor_id")
  vendor   Vendor           @relation(fields: [vendorId], references: [vendorId], onDelete: Cascade)
  bookings Booking[]
  services PackageService[]
  images   PackageImage[]

  @@map("event_package")
}

model PackageService {
  serviceId Int          @id @default(autoincrement()) @map("service_id")
  name      String
  packageId Int          @map("package_id")
  package   EventPackage @relation(fields: [packageId], references: [packageId], onDelete: Cascade)

  @@map("package_service")
}

model PackageImage {
  imageId   Int          @id @default(autoincrement()) @map("image_id")
  url       String
  packageId Int          @map("package_id")
  package   EventPackage @relation(fields: [packageId], references: [packageId], onDelete: Cascade)

  @@map("package_image")
}

model Availability {
  availabilityId Int      @id @default(autoincrement()) @map("availability_id")
  date           DateTime @db.Date
  startTime      String   @map("start_time")
  endTime        String   @map("end_time")
  isAvailable    Boolean  @default(true) @map("is_available")

  vendorId Int    @map("vendor_id")
  vendor   Vendor @relation(fields: [vendorId], references: [vendorId], onDelete: Cascade)

  @@map("availability")
}

model Booking {
  bookingId          Int           @id @default(autoincrement()) @map("booking_id")
  bookingDate        DateTime      @default(now()) @map("booking_date")
  eventDate          DateTime      @map("event_date") @db.Date
  status             BookingStatus @default(PENDING)
  location           String?
  vendorResponseDate DateTime?     @map("vendor_response_date")

  customerId Int           @map("customer_id")
  serviceId  Int?          @map("service_id")
  packageId  Int?          @map("package_id")
  customer   Customer      @relation(fields: [customerId], references: [customerId], onDelete: Cascade)
  service    Service?      @relation(fields: [serviceId], references: [serviceId], onDelete: SetNull)
  package    EventPackage? @relation(fields: [packageId], references: [packageId], onDelete: SetNull)
  payment    Payment?
  disputes   Dispute[]

  @@map("booking")
}

model Cart {
  cartId     Int        @id @default(autoincrement()) @map("cart_id")
  customerId Int        @unique @map("customer_id")
  customer   Customer   @relation(fields: [customerId], references: [customerId], onDelete: Cascade)
  cartItems  CartItem[]

  @@map("cart")
}

model CartItem {
  cartItemId Int     @id @default(autoincrement()) @map("cart_item_id")
  quantity   Int     @default(1)
  cartId     Int     @map("cart_id")
  productId  Int     @map("product_id")
  cart       Cart    @relation(fields: [cartId], references: [cartId], onDelete: Cascade)
  product    Product @relation(fields: [productId], references: [productId], onDelete: Cascade)

  @@map("cart_item")
}

model Order {
  orderId         Int         @id @default(autoincrement()) @map("order_id")
  orderDate       DateTime    @default(now()) @map("order_date")
  totalAmount     Decimal     @map("total_amount") @db.Decimal(10, 2)
  status          OrderStatus @default(PENDING)
  shippingAddress String      @map("shipping_address")

  customerId Int         @map("customer_id")
  customer   Customer    @relation(fields: [customerId], references: [customerId], onDelete: Cascade)
  orderItems OrderItem[]
  payment    Payment?
  refunds    RefundRequest[]

  @@map("order")
}

model OrderItem {
  orderItemId Int     @id @default(autoincrement()) @map("order_item_id")
  quantity    Int
  unitPrice   Decimal @map("unit_price") @db.Decimal(10, 2)
  orderId     Int     @map("order_id")
  productId   Int     @map("product_id")
  order       Order   @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [productId], onDelete: Cascade)

  @@map("order_item")
}

model Payment {
  paymentId     Int           @id @default(autoincrement()) @map("payment_id")
  amount        Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod @map("payment_method")
  status        PaymentStatus @default(PENDING)
  transactionId String?       @map("transaction_id")
  paidAt        DateTime?     @map("paid_at")
  createdAt     DateTime      @default(now()) @map("created_at")

  bookingId Int?     @unique @map("booking_id")
  orderId   Int?     @unique @map("order_id")
  booking   Booking? @relation(fields: [bookingId], references: [bookingId], onDelete: SetNull)
  order     Order?   @relation(fields: [orderId], references: [orderId], onDelete: SetNull)

  @@map("payment")
}

model Review {
  reviewId   Int      @id @default(autoincrement()) @map("review_id")
  rating     Int
  comment    String?
  reviewDate DateTime @default(now()) @map("review_date")

  customerId Int      @map("customer_id")
  vendorId   Int?     @map("vendor_id")
  serviceId  Int?     @map("service_id")
  productId  Int?     @map("product_id")
  customer   Customer @relation(fields: [customerId], references: [customerId], onDelete: Cascade)
  vendor     Vendor?  @relation(fields: [vendorId], references: [vendorId], onDelete: Cascade)
  service    Service? @relation(fields: [serviceId], references: [serviceId], onDelete: SetNull)
  product    Product? @relation(fields: [productId], references: [productId], onDelete: SetNull)

  @@map("review")
}

model Message {
  messageId      Int      @id @default(autoincrement()) @map("message_id")
  conversationId String   @map("conversation_id")
  senderId       Int      @map("sender_id")
  senderType     String   @map("sender_type")
  receiverId     Int      @map("receiver_id")
  receiverType   String   @map("receiver_type")
  content        String
  isRead         Boolean  @default(false) @map("is_read")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("message")
}

model Notification {
  notificationId Int      @id @default(autoincrement()) @map("notification_id")
  type           String
  message        String
  isRead         Boolean  @default(false) @map("is_read")
  createdAt      DateTime @default(now()) @map("created_at")

  customerId Int?      @map("customer_id")
  customer   Customer? @relation(fields: [customerId], references: [customerId], onDelete: SetNull)
  vendorId   Int?      @map("vendor_id")
  vendor     Vendor?   @relation(fields: [vendorId], references: [vendorId], onDelete: SetNull)

  @@map("notification")
}

model SystemSetting {
  id                      Int      @id @default(autoincrement()) @map("id")
  platformName            String   @default("Nexora Marketplace") @map("platformName")
  supportEmail            String   @default("support@nexora.com") @map("supportEmail")
  logoUrl                 String?  @map("logoUrl")
  defaultTimezone         String   @default("UTC") @map("defaultTimezone")
  defaultCurrency         String   @default("LKR") @map("defaultCurrency")
  maintenanceMode         Boolean  @default(false) @map("maintenanceMode")
  commissionPercent       Int      @default(10) @map("commissionPercent")
  paymentGateway          String   @default("Stripe") @map("paymentGateway")
  smtpHost                String?  @map("smtpHost")
  smtpPort                Int?     @map("smtpPort")
  smtpUser                String?  @map("smtpUser")
  smtpPassword            String?  @map("smtpPassword")
  smtpFromEmail           String?  @map("smtpFromEmail")
  smtpSecure              Boolean  @default(false) @map("smtpSecure")
  authLockoutEnabled      Boolean  @default(false) @map("authLockoutEnabled")
  authFailedAttemptsLimit Int      @default(5) @map("authFailedAttemptsLimit")
  authPasswordMinLength   Int      @default(8) @map("authPasswordMinLength")
  authTwoFactorEnabled    Boolean  @default(false) @map("authTwoFactorEnabled")
  createdAt               DateTime @default(now()) @map("createdAt")
  updatedAt               DateTime @updatedAt @map("updatedAt")

  @@map("system_setting")
}

model Dispute {
  disputeId   Int           @id @default(autoincrement()) @map("dispute_id")
  bookingId   Int?          @map("booking_id")
  customerId  Int?          @map("customer_id")
  vendorId    Int?          @map("vendor_id")
  raisedBy    String        @map("raised_by")
  reporter    String?
  subject     String
  description String
  status      DisputeStatus @default(OPEN)
  adminNotes  String?       @map("admin_notes")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  booking  Booking?  @relation(fields: [bookingId], references: [bookingId], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [customerId], onDelete: SetNull)
  vendor   Vendor?   @relation(fields: [vendorId], references: [vendorId], onDelete: SetNull)

  @@map("dispute")
}

model Broadcast {
  broadcastId    Int      @id @default(autoincrement()) @map("broadcast_id")
  title          String
  message        String
  type           String   @default("info") @map("type")
  targetRole     String   @map("target_role")
  recipientCount Int      @default(0) @map("recipient_count")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("broadcast")
}

model ImpersonationLog {
  id         Int      @id @default(autoincrement())
  adminId    Int      @map("admin_id")
  targetRole String   @map("target_role")
  targetId   Int      @map("target_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("impersonation_log")
}

model Budget {
  budgetId    Int          @id @default(autoincrement()) @map("budget_id")
  customerId  Int          @map("customer_id")
  title       String       @default("My Event Budget")
  totalBudget Float        @default(0) @map("total_budget")
  eventDate   DateTime?    @map("event_date")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  customer    Customer     @relation(fields: [customerId], references: [customerId], onDelete: Cascade)
  items       BudgetItem[]

  @@map("budget")
}

model BudgetItem {
  budgetItemId Int      @id @default(autoincrement()) @map("budget_item_id")
  budgetId     Int      @map("budget_id")
  category     String   @default("General")
  title        String
  estimatedCost Float   @default(0) @map("estimated_cost")
  actualCost   Float    @default(0) @map("actual_cost")
  isPaid       Boolean  @default(false) @map("is_paid")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")

  budget       Budget   @relation(fields: [budgetId], references: [budgetId], onDelete: Cascade)

  @@map("budget_item")
}

model RefundRequest {
  refundId    Int      @id @default(autoincrement()) @map("refund_id")
  orderId     Int      @map("order_id")
  customerId  Int      @map("customer_id")
  reason      String
  amount      Float
  status      String   @default("PENDING")
  sellerNotes String?  @map("seller_notes")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  order       Order    @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  customer    Customer @relation(fields: [customerId], references: [customerId], onDelete: Cascade)

  @@map("refund_request")
}
